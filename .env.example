# ---------------------------------------------------------------------------
# Cloudinary — owner-managed gallery photos.
# Copy this file to `.env.local` for local dev, and add the same variables in
# Vercel → Project → Settings → Environment Variables for production.
# Full instructions: see CLOUDINARY_SETUP.md
#
# All three of CLOUD_NAME / API_KEY / API_SECRET must be set, otherwise the
# gallery falls back to the bundled photos in /public/images.
# NEVER commit real values — .env.local is git-ignored.
# ---------------------------------------------------------------------------

# Cloudinary "Cloud name" (Dashboard → Product Environment)
CLOUDINARY_CLOUD_NAME=

# Admin API credentials (Dashboard → API Keys). Server-side only — these are
# never sent to the browser.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Which Cloudinary tag to show in the gallery. Leave as "gallery".
CLOUDINARY_GALLERY_TAG=gallery
